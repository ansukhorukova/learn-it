{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "Anastasiya Brand System",
    "version": "1.0.0",
    "principle": "Dark technical foundation. Pink energy. Human warmth."
  },
  "color": {
    "background": {
      "primary": "#080910",
      "secondary": "#10111B",
      "tertiary": "#131522"
    },
    "surface": {
      "default": "#171824",
      "elevated": "#1F1F2E",
      "muted": "#14151E"
    },
    "text": {
      "primary": "#F7F7FA",
      "secondary": "#B5B5C3",
      "muted": "#7E8091",
      "inverse": "#080910"
    },
    "brand": {
      "pink": "#FF3B91",
      "magenta": "#E62E8B",
      "purple": "#8B5CF6",
      "softPink": "#FF7DB7"
    },
    "border": {
      "default": "rgba(255,255,255,0.10)",
      "strong": "rgba(255,255,255,0.18)",
      "brand": "rgba(255,59,145,0.55)"
    },
    "semantic": {
      "success": "#22C55E",
      "warning": "#F59E0B",
      "info": "#3B82F6",
      "error": "#EF4444"
    }
  },
  "gradient": {
    "brand": "linear-gradient(135deg, #FF3B91 0%, #E62E8B 100%)",
    "purple": "linear-gradient(135deg, #C026D3 0%, #8B5CF6 100%)",
    "night": "linear-gradient(135deg, #10111B 0%, #1F1F2E 100%)"
  },
  "shadow": {
    "sm": "0 4px 16px rgba(0,0,0,0.20)",
    "md": "0 10px 30px rgba(0,0,0,0.28)",
    "brandSoft": "0 0 24px rgba(255,59,145,0.18)",
    "focus": "0 0 0 3px rgba(255,59,145,0.24)"
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "pill": "999px"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px"
  },
  "typography": {
    "fontFamily": "Inter, Geist, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "display": {
      "size": "64px",
      "lineHeight": "1.02",
      "weight": 700
    },
    "h1": {
      "size": "40px",
      "lineHeight": "1.1",
      "weight": 700
    },
    "h2": {
      "size": "32px",
      "lineHeight": "1.15",
      "weight": 700
    },
    "h3": {
      "size": "24px",
      "lineHeight": "1.2",
      "weight": 600
    },
    "body": {
      "size": "16px",
      "lineHeight": "1.6",
      "weight": 400
    },
    "small": {
      "size": "14px",
      "lineHeight": "1.5",
      "weight": 400
    },
    "micro": {
      "size": "12px",
      "lineHeight": "1.4",
      "weight": 500
    }
  },
  "motion": {
    "fast": "140ms",
    "normal": "200ms",
    "slow": "280ms",
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  }
}
