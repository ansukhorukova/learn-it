# Postgres (Docker)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=learning_time_tracker

# MinIO (Docker) — local S3-compatible object storage, no cloud account needed
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
STORAGE_BUCKET=learning-attachments

# Firebase project (free Spark plan) — Auth ONLY. Firebase Storage now requires
# the paid Blaze plan even for free-tier usage (policy change, Feb 2026), so we
# don't use it for local dev — see CLAUDE.md "Файлове сховище" section.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase client SDK config (safe to expose to FE — public config, not secret)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com

# Optional. Leave unset for local dev — the frontend derives the API base
# from the browser hostname, so it works at localhost AND from other devices
# on the LAN. Set only to point at a non-default backend host/port.
# VITE_API_URL=http://localhost:4000/api/v1

# Place your Firebase service-account JSON (Project settings → Service accounts → Generate new private key)
# at ./firebase-service-account.json — NEVER commit this file, it's already in .gitignore.
